# Server environment (never commit real values)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Least-privilege Postgres role used by the API (Supabase pooled connection string)
DATABASE_URL=postgresql://hush_app:CHANGE_ME@localhost:5432/hush
# Direct connection used only by `npm run db:migrate` (falls back to DATABASE_URL)
DIRECT_URL=postgresql://hush_migrator:CHANGE_ME@localhost:5432/hush
DB_POOL_MAX=10

# Comma-separated list of approved browser origins
CORS_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (0 = none). Needed for correct per-IP rate limits.
TRUST_PROXY=0

# Supabase Auth: tokens are verified against this project's JWKS. No service-role key is needed.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Optional: legacy HS256 projects only (leave empty for JWKS verification)
SUPABASE_JWT_SECRET=

# Comma-separated auth subjects (Supabase user ids) allowed to use moderation endpoints
MODERATOR_AUTH_SUBJECTS=
# Optional comma-separated hostnames allowed for avatar URLs (empty = any https host)
AVATAR_HOSTS=
